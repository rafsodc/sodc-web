# Copy to .env.session-e2e; start Auth, Functions and Data Connect emulators.
# This demo project cannot be used for live Firebase resources.
VITE_FIREBASE_API_KEY=demo-session-isolation
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-sodc-session-isolation
VITE_FIREBASE_APP_ID=1:000000000000:web:session-isolation
VITE_USE_FIREBASE_EMULATORS=true
