rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Section files use short-lived, backend-issued signed URLs. Firebase
    // Storage client SDK access stays closed so bucket objects can never be
    // reached merely by signing in or knowing an object path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
